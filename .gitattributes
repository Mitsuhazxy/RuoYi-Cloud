# 规范化行尾:文本文件统一 LF(部署目标为 Linux)
* text=auto

# 明确使用 LF 的文件类型
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.vm text eol=lf
*.dockerfile text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# 二进制文件不转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
